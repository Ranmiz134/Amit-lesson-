  </footer>

  <script>
    (function() {
      // --- State Management ---
      var revealedSet = new Set();
      var teacherMode = false;

      function saveState() {
        try {
          var notes = {};
          document.querySelectorAll('[data-question-card]').forEach(function(card) {
            var qId = card.getAttribute('data-question-card');
            var ta = card.querySelector('textarea');
            if (ta) notes[qId] = ta.value;
          });
          localStorage.setItem('physics_lab_revealed', JSON.stringify(Array.from(revealedSet)));
          localStorage.setItem('physics_lab_notes', JSON.stringify(notes));
        } catch (e) {}
      }

      function loadState() {
        try {
          var savedRev = localStorage.getItem('physics_lab_revealed');
          if (savedRev) {
            JSON.parse(savedRev).forEach(function(id) { revealedSet.add(id); });
          }
          var savedNotes = localStorage.getItem('physics_lab_notes');
          if (savedNotes) {
            var notesObj = JSON.parse(savedNotes);
            Object.keys(notesObj).forEach(function(qId) {
              var card = document.querySelector('[data-question-card="' + qId + '"]');
              if (card) {
                var ta = card.querySelector('textarea');
                if (ta) ta.value = notesObj[qId];
              }
            });
          }
        } catch (e) {}
      }

      function updateProgressUI() {
        var total = 12;
        var count = revealedSet.size;
        var counterEl = document.getElementById('progressCounter');
        var barEl = document.getElementById('progressBar');
        if (counterEl) counterEl.textContent = count + ' / ' + total;
        if (barEl) barEl.style.width = Math.round((count / total) * 100) + '%';

        document.querySelectorAll('[data-question-card]').forEach(function(card) {
          var qId = card.getAttribute('data-question-card');
          var ansBox = card.querySelector('.answer-box');
          var statusEl = card.querySelector('.q-status');
          var btnEl = card.querySelector('.reveal-btn');
          var isShown = revealedSet.has(qId) || teacherMode;
          if (ansBox) {
            if (isShown) {
              ansBox.classList.remove('hidden');
            } else {
              ansBox.classList.add('hidden');
            }
          }
          if (statusEl) {
            statusEl.textContent = isShown ? '✅ נחשף וסוכם' : 'טרם נחשף';
            statusEl.className = 'q-status text-xs font-bold ' + (isShown ? 'text-emerald-400' : 'text-slate-400');
          }
          if (btnEl) {
            btnEl.textContent = isShown ? '🙈 הסתר הסבר' : '👁️ חשוף את ההסבר הפיזיקלי';
          }
        });
      }

      // --- Tab Switching ---
      function switchTab(tabId) {
        document.querySelectorAll('.tab-panel').forEach(function(panel) {
          if (panel.id === tabId) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
        document.querySelectorAll('.nav-tab').forEach(function(btn) {
          if (btn.getAttribute('data-tab') === tabId) {
            btn.classList.add('tab-active');
            btn.classList.remove('bg-slate-800/80', 'text-slate-300');
          } else {
            btn.classList.remove('tab-active');
            btn.classList.add('bg-slate-800/80', 'text-slate-300');
          }
        });
        window.scrollTo({ top: 0, behavior: 'smooth' });
        if (tabId === 'tab-station2') drawOrbitScene(parseInt(document.getElementById('orbitalSpeedSlider').value, 10), false);
        if (tabId === 'tab-station3') drawVacuumFrame(0, false);
      }

      document.querySelectorAll('.nav-tab').forEach(function(btn) {
        btn.addEventListener('click', function() {
          switchTab(btn.getAttribute('data-tab'));
        });
      });

      document.querySelectorAll('[data-goto]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          switchTab(btn.getAttribute('data-goto'));
        });
      });

      // --- Question Reveal & Notes ---
      document.querySelectorAll('[data-question-card]').forEach(function(card) {
        var qId = card.getAttribute('data-question-card');
        var btn = card.querySelector('.reveal-btn');
        var ta = card.querySelector('textarea');
        if (btn) {
          btn.addEventListener('click', function() {
            if (revealedSet.has(qId)) {
              revealedSet.delete(qId);
            } else {
              revealedSet.add(qId);
            }
            saveState();
            updateProgressUI();
          });
        }
        if (ta) {
          ta.addEventListener('input', function() {
            saveState();
          });
        }
      });

      var toggleTeacherBtn = document.getElementById('toggleTeacherBtn');
      if (toggleTeacherBtn) {
        toggleTeacherBtn.addEventListener('click', function() {
          teacherMode = !teacherMode;
          toggleTeacherBtn.textContent = teacherMode ? '🔒 סגור מצב מדריך' : '💡 מצב מדריך (חשוף הכול)';
          updateProgressUI();
        });
      }

      var resetProgressBtn = document.getElementById('resetProgressBtn');
      if (resetProgressBtn) {
        resetProgressBtn.addEventListener('click', function() {
          revealedSet.clear();
          teacherMode = false;
          document.querySelectorAll('[data-question-card] textarea').forEach(function(ta) {
            ta.value = '';
          });
          try {
            localStorage.removeItem('physics_lab_revealed');
            localStorage.removeItem('physics_lab_notes');
          } catch (e) {}
          updateProgressUI();
        });
      }

      // --- Simulator 1: Thrust & Lift Lab ---
      var launchSimBtn = document.getElementById('launchSimBtn');
      if (launchSimBtn) {
        launchSimBtn.addEventListener('click', function() {
          var env = document.getElementById('envSelect').value;
          var craft = document.getElementById('craftSelect').value;
          var titleEl = document.getElementById('sim1StatusTitle');
          var descEl = document.getElementById('sim1StatusDesc');
          var badgeEl = document.getElementById('sim1VisualBadge');

          if (env === 'earth' && craft === 'drone_std') {
            titleEl.textContent = '✅ המראה חלקה! הרחפן דוחף אוויר צפוף וממריא בקלות.';
            titleEl.className = 'text-base font-extrabold text-emerald-400';
            descEl.textContent = 'בכדור הארץ האוויר צפוף. המדחפים דוחפים כמות גדולה של אוויר כלפי מטה (פעולה), והאוויר דוחף את הרחפן למעלה (תגובה).';
            badgeEl.textContent = '🚁⬆️';
          } else if (env === 'earth' && craft === 'drone_mars') {
            titleEl.textContent = '⚡ עילוי אדיר! הלהבים המהירים של Ingenuity מזניקים אותו למעלה.';
            titleEl.className = 'text-base font-extrabold text-emerald-400';
            descEl.textContent = 'עם להבים שמסתובבים ב-2,500 סל"ד באוויר הצפוף של כדור הארץ, כוח התגובה של האוויר חזק פי כמה ממשקל הרחפן!';
            badgeEl.textContent = '🛸💨';
          } else if (env === 'mars' && craft === 'drone_std') {
            titleEl.textContent = '❌ נשאר על הקרקע! האוויר במאדים דליל מדי לרחפן רגיל.';
            titleEl.className = 'text-base font-extrabold text-rose-400';
            descEl.textContent = 'האטמוספירה של מאדים היא רק 1% מצפיפות האוויר בכדור הארץ. מדחף רגיל מסתובב "על ריק" ולא מצליח לדחוף מספיק אוויר מטה כדי לייצר כוח תגובה שינצח את הכבידה.';
            badgeEl.textContent = '🚁⬇️';
          } else if (env === 'mars' && craft === 'drone_mars') {
            titleEl.textContent = '🏆 הצלחה היסטורית! כך בדיוק טס מסוק המאדים Ingenuity של נאס"א!';
            titleEl.className = 'text-base font-extrabold text-emerald-400';
            descEl.textContent = 'בזכות להבים גדולים שמסתובבים פי 5 מהר יותר (2,500 סל"ד) ומשקל קל במיוחד, הוא מצליח להאיץ גם את מעט האוויר שיש במאדים ולקבל מספיק כוח תגובה כלפי מעלה!';
            badgeEl.textContent = '🛸🔴';
          } else if (env === 'moon' && (craft === 'drone_std' || craft === 'drone_mars')) {
            titleEl.textContent = '❌ דממה מוחלטת – המדחפים מסתובבים אבל הכלי לא זז מילימטר!';
            titleEl.className = 'text-base font-extrabold text-rose-400';
            descEl.textContent = 'בירח ובחלל שורר ואקום (אין אוויר כלל!). גם אם המדחפים יסתובבו במהירות של 100,000 סל"ד, אין להם שום אוויר לדחוף כלפי מטה ולכן אין שום כוח תגובה שידחף אותם למעלה!';
            badgeEl.textContent = '🌑🚫';
          } else if (craft === 'rocket') {
            titleEl.textContent = '🚀 המראה עוצמתית בכל סביבה (גם בוואקום מוחלט בחלל)!';
            titleEl.className = 'text-base font-extrabold text-sky-400';
            descEl.textContent = 'מנוע רקטי לא זקוק לאוויר חיצוני כלל! הוא מביא איתו את החומר במכלים פנימיים, זורק גזים אחורה במהירות אדירה (פעולה), והגזים הנפלטים דוחפים את החללית קדימה (תגובה).';
            badgeEl.textContent = '🚀✨';
          }
        });
      }

      // --- Simulator 2: Newton's Orbital Cannonball ---
      var orbitAnimId = null;
      var orbitSlider = document.getElementById('orbitalSpeedSlider');
      var orbitValEl = document.getElementById('orbitalSpeedVal');

      function drawOrbitScene(speedKmh, animate) {
        var canvas = document.getElementById('orbitCanvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (orbitAnimId) {
          cancelAnimationFrame(orbitAnimId);
          orbitAnimId = null;
        }

        var cx = 210, cy = 125, earthR = 68, launchR = 96;
        var maxSteps = speedKmh >= 26000 ? 360 : Math.max(25, Math.round((speedKmh / 26000) * 185));
        var isFullOrbit = speedKmh >= 26000;
        var explainEl = document.getElementById('orbitExplainBox');

        if (explainEl) {
          if (speedKmh === 0) {
            explainEl.textContent = 'במהירות אופקית 0 קמ"ש: החללית פשוט נופלת בקו ישר למטה ופוגעת מיד בקרקע.';
          } else if (!isFullOrbit) {
            explainEl.textContent = 'במהירות ' + speedKmh.toLocaleString() + ' קמ"ש: החללית עפה קדימה בזמן שהיא נופלת בקשת רחבה, אך מהירותה עדיין לא מספיקה כדי "לפספס" את כדור הארץ והיא נוחתת.';
          } else {
            explainEl.textContent = '🎉 28,000 קמ"ש – מסלול הקפה מושלם! החללית נופלת כל הזמן לכיוון כדור הארץ בגלל הכבידה, אבל כדור הארץ מתעקם מתחתיה באותו קצב בדיוק! זוהי נפילה חופשית מתמדת.';
          }
        }

        var step = animate ? 0 : maxSteps;

        function renderFrame() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);

          // Stars
          ctx.fillStyle = '#334155';
          for (var s = 0; s < 25; s++) {
            ctx.fillRect((s * 73) % 410, (s * 41) % 230, 2, 2);
          }

          // Earth
          var grad = ctx.createRadialGradient(cx - 15, cy - 15, 10, cx, cy, earthR);
          grad.addColorStop(0, '#38bdf8');
          grad.addColorStop(1, '#1d4ed8');
          ctx.beginPath();
          ctx.arc(cx, cy, earthR, 0, Math.PI * 2);
          ctx.fillStyle = grad;
          ctx.fill();
          ctx.strokeStyle = '#7dd3fc';
          ctx.lineWidth = 2;
          ctx.stroke();

          // Mountain at top
          ctx.beginPath();
          ctx.moveTo(cx - 12, cy - earthR + 2);
          ctx.lineTo(cx, cy - launchR);
          ctx.lineTo(cx + 12, cy - earthR + 2);
          ctx.fillStyle = '#94a3b8';
          ctx.fill();

          // Trajectory path
          ctx.beginPath();
          ctx.strokeStyle = isFullOrbit ? '#34d399' : '#f59e0b';
          ctx.lineWidth = 2.5;
          var lastX = cx, lastY = cy - launchR;
          for (var i = 0; i <= step; i++) {
            var angleDeg = i;
            var rad = (angleDeg - 90) * (Math.PI / 180);
            var r = isFullOrbit
              ? launchR
              : launchR - ((launchR - earthR) * Math.pow(i / maxSteps, 1.55));
            var px = cx + r * Math.cos(rad);
            var py = cy + r * Math.sin(rad);
            if (i === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
            lastX = px;
            lastY = py;
          }
          ctx.stroke();

          // Craft dot
          ctx.beginPath();
          ctx.arc(lastX, lastY, 6, 0, Math.PI * 2);
          ctx.fillStyle = '#ffffff';
          ctx.fill();

          if (animate && step < maxSteps) {
            step += 4;
            orbitAnimId = requestAnimationFrame(renderFrame);
          }
        }
        renderFrame();
      }

      if (orbitSlider) {
        orbitSlider.addEventListener('input', function() {
          var val = parseInt(orbitSlider.value, 10);
          if (orbitValEl) orbitValEl.textContent = val.toLocaleString() + ' קמ"ש';
          drawOrbitScene(val, false);
        });
      }

      var fireCannonBtn = document.getElementById('fireCannonBtn');
      if (fireCannonBtn) {
        fireCannonBtn.addEventListener('click', function() {
          var val = parseInt(orbitSlider.value, 10);
          drawOrbitScene(val, true);
        });
      }

      var setOrbitSpeedBtn = document.getElementById('setOrbitSpeedBtn');
      if (setOrbitSpeedBtn) {
        setOrbitSpeedBtn.addEventListener('click', function() {
          orbitSlider.value = '28000';
          if (orbitValEl) orbitValEl.textContent = '28,000 קמ"ש';
          drawOrbitScene(28000, true);
        });
      }

      // --- Simulator 3: NASA Vacuum Chamber ---
      var vacAnimId = null;

      function drawVacuumFrame(progress, isVacuum) {
        var canvas = document.getElementById('vacuumCanvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Chamber frame
        ctx.strokeStyle = isVacuum ? '#10b981' : '#64748b';
        ctx.lineWidth = 3;
        ctx.strokeRect(40, 15, 340, 190);

        // Air particles if with air
        if (!isVacuum) {
          ctx.fillStyle = 'rgba(148, 163, 184, 0.35)';
          for (var p = 0; p < 55; p++) {
            ctx.beginPath();
            ctx.arc(55 + ((p * 53) % 310), 30 + ((p * 29) % 160), 2, 0, Math.PI * 2);
            ctx.fill();
          }
        }

        var startY = 40, floorY = 182;
        var ballP = Math.min(1, progress * 1.4);
        var featherP = isVacuum ? ballP : Math.min(1, progress);

        var ballY = startY + (floorY - startY) * (ballP * ballP);
        var featherY = isVacuum
          ? ballY
          : startY + (floorY - startY) * featherP;

        // Bowling ball
        ctx.beginPath();
        ctx.arc(145, ballY, 15, 0, Math.PI * 2);
        ctx.fillStyle = '#38bdf8';
        ctx.fill();
        ctx.fillStyle = '#0f172a';
        ctx.font = 'bold 11px sans-serif';
        ctx.fillText('7kg', 135, ballY + 4);

        // Feather
        ctx.beginPath();
        ctx.ellipse(275, featherY, 16, 6, -0.3, 0, Math.PI * 2);
        ctx.fillStyle = '#fde047';
        ctx.fill();

        // Update Energy bars for feather
        var ep = Math.max(0, Math.round((1 - (featherY - startY) / (floorY - startY)) * 100));
        var used = 100 - ep;
        var ek = isVacuum ? used : Math.min(15, used);
        var heat = isVacuum ? 0 : Math.max(0, used - ek);

        var epPctEl = document.getElementById('epPct');
        var ekPctEl = document.getElementById('ekPct');
        var heatPctEl = document.getElementById('heatPct');
        if (epPctEl) epPctEl.textContent = ep + '%';
        if (ekPctEl) ekPctEl.textContent = ek + '%';
        if (heatPctEl) heatPctEl.textContent = heat + '%';

        var epBarEl = document.getElementById('epBar');
        var ekBarEl = document.getElementById('ekBar');
        var heatBarEl = document.getElementById('heatBar');
        if (epBarEl) epBarEl.style.width = ep + '%';
        if (ekBarEl) ekBarEl.style.width = ek + '%';
        if (heatBarEl) heatBarEl.style.width = heat + '%';
      }

      function startVacuumDrop(isVacuum) {
        if (vacAnimId) {
          cancelAnimationFrame(vacAnimId);
          vacAnimId = null;
        }
        var labelEl = document.getElementById('vacuumModeLabel');
        if (labelEl) {
          labelEl.textContent = isVacuum
            ? '✨ מצב ואקום (ללא אוויר): הכדור והנוצה נופלים יחד באותה תאוצה בדיוק!'
            : '🌬️ מצב חדר עם אוויר: האוויר בולם את הנוצה והופך את אנרגיית הגובה שלה לחום!';
        }
        var prog = 0;
        function stepAnim() {
          prog += 0.015;
          drawVacuumFrame(prog, isVacuum);
          var done = isVacuum ? (prog * 1.4 >= 1) : (prog >= 1);
          if (!done) {
            vacAnimId = requestAnimationFrame(stepAnim);
          }
        }
        stepAnim();
      }

      var dropWithAirBtn = document.getElementById('dropWithAirBtn');
      if (dropWithAirBtn) {
        dropWithAirBtn.addEventListener('click', function() {
          startVacuumDrop(false);
        });
      }

      var dropVacuumBtn = document.getElementById('dropVacuumBtn');
      if (dropVacuumBtn) {
        dropVacuumBtn.addEventListener('click', function() {
          startVacuumDrop(true);
        });
      }

      // --- Simulator 4: Pressure Selector ---
      var pressureScenarios = {
        single_nail: {
          title: '📍 דריכה על מסמר בודד: כל המשקל על חוד אחד!',
          text: 'כשכל משקל הגוף מתרכז על חוד של מסמר אחד בלבד, שטח המגע קטן ממילימטר רבוע. הלחץ בנקודה הזו עצום והמסמר חודר מיד את הנעל או הבלון.',
          gauge: '🔥 קיצונית (חודר מיד!)',
          color: 'text-rose-400'
        },
        bed_nails: {
          title: '🛏️ שכיבה על מיטת 1,000 מסמרים: המשקל מתחלק!',
          text: 'כאשר שוכבים על 1,000 מסמרים צפופים, משקל הגוף מתפזר על פני 1,000 חודים במקביל. כל מסמר בודד נושא רק אלפית ממשקל הגוף – ולכן הלחץ בכל נקודה קטן פי 1,000 ואינו פוצע את העור!',
          gauge: '✅ נמוכה ובטוחה (פיזור רחב)',
          color: 'text-emerald-400'
        },
        heel_vs_elephant: {
          title: '👠 ההפתעה הגדולה: עקב סיכה דק מנצח רגל של פיל!',
          text: 'פיל שוקל פי 70 מאדם, אבל כף הרגל שלו רחבה מאוד והמשקל מתחלק על 4 רגליים. לעומתו, אישה שנשענת על עקב סיכה דקיק מרכזת את כל משקלה על שטח של סנטימטר רבוע אחד – ויוצרת לחץ גדול פי 30 מרגל הפיל (ולכן עקבים שוקעים בדשא ורגל פיל פחות!).',
          gauge: '⚡ בעקב: לחץ גדול פי 30 מהפיל!',
          color: 'text-amber-400'
        },
        jeep_sand: {
          title: '🚙 רכב שטח בדיונות: למה מוציאים אוויר מהצמיגים לפני כניסה לחול?',
          text: 'המשקל של הג\'יפ לא משתנה כשמוציאים אוויר מהצמיגים! אבל צמיג עם פחות אוויר משתטח מעט על החול ומגדיל מאוד את שטח המגע ("טביעת הרגל") שלו עם הדיונה. הגדלת השטח מקטינה את הלחץ ומונעת מהגלגלים לשקוע ולהתחפר!',
          gauge: '🛞 לחץ מופחת – צף על החול!',
          color: 'text-sky-400'
        }
      };

      document.querySelectorAll('.pressure-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var key = btn.getAttribute('data-pressure');
          var data = pressureScenarios[key];
          if (!data) return;
          document.querySelectorAll('.pressure-btn').forEach(function(b) {
            b.className = 'pressure-btn py-2.5 px-3 rounded-xl text-xs font-bold bg-slate-800 text-slate-200 hover:bg-slate-700 transition';
          });
          btn.className = 'pressure-btn py-2.5 px-3 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 transition';
          document.getElementById('pressureTitle').textContent = data.title;
          document.getElementById('pressureText').textContent = data.text;
          var gEl = document.getElementById('pressureGaugeText');
          gEl.textContent = data.gauge;
          gEl.className = 'text-lg font-extrabold ' + data.color;
        });
      });

      // Init
      loadState();
      updateProgressUI();
      drawOrbitScene(12000, false);
      drawVacuumFrame(0, false);
    })();
  </script>
